# Copy to keystore.properties (gitignored) and fill in real passwords.
# Generate keystore once:
#   keytool -genkeypair -v -keystore doposai-release.jks -alias doposai \
#     -keyalg RSA -keysize 2048 -validity 10000 -storetype JKS
#
# NEVER commit keystore.properties or *.jks to git.

storeFile=doposai-release.jks
storePassword=CHANGE_ME
keyAlias=doposai
keyPassword=CHANGE_ME
